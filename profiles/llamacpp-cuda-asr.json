{
  "name": "llamacpp-cuda-asr",
  "description": "Local llama.cpp server with Silero VAD and CUDA faster-whisper ASR.",
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "frame_ms": 30,
    "pre_speech_ms": 450,
    "max_utterance_ms": 30000
  },
  "vad": {
    "provider": "silero",
    "speech_threshold": 0.65,
    "neg_threshold": 0.4,
    "hangover_ms": 450,
    "min_speech_duration_ms": 300
  },
  "asr": {
    "provider": "faster-whisper",
    "model": "large-v3-turbo",
    "device": "cuda",
    "compute_type": "float16",
    "language": "en",
    "beam_size": 1,
    "vad_filter": false,
    "condition_on_previous_text": false,
    "temperature": 0,
    "compression_ratio_threshold": 2.4,
    "log_prob_threshold": -0.5,
    "no_speech_threshold": 0.2,
    "reject_low_energy_rms": 0.003,
    "reject_low_energy_max_duration_ms": 900,
    "reject_utterance_rms": 0.002,
    "trim_silence_rms": 0.003,
    "trim_silence_frame_ms": 30,
    "timeout_s": 180
  },
  "llm": {
    "provider": "llamacpp",
    "base_url": "http://127.0.0.1:8080",
    "model": "auto",
    "temperature": 0.7,
    "max_tokens": 256
  },
  "tts": {
    "provider": "pocket-tts",
    "voice": "azelma",
    "temp": 0.7,
    "max_tokens": 50,
    "quantize": false
  },
  "turn": {
    "barge_in": "cancel_tts",
    "tts_chunk_chars": 260,
    "min_tts_chars": 110
  }
}
