{
  "name": "llamacpp-kokoro-onnx",
  "description": "Local llama.cpp server with Silero VAD, faster-whisper ASR, and Kokoro v1.0 ONNX TTS.",
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "frame_ms": 30,
    "pre_speech_ms": 450,
    "max_utterance_ms": 30000
  },
  "vad": {
    "provider": "silero",
    "speech_threshold": 0.6,
    "neg_threshold": 0.35,
    "hangover_ms": 450,
    "min_speech_duration_ms": 200
  },
  "asr": {
    "provider": "faster-whisper",
    "model": "large-v3-turbo",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "beam_size": 1,
    "vad_filter": false,
    "condition_on_previous_text": false,
    "temperature": 0,
    "compression_ratio_threshold": 2.4,
    "log_prob_threshold": -0.5,
    "no_speech_threshold": 0.2,
    "reject_low_energy_rms": 0.003,
    "reject_low_energy_max_duration_ms": 900,
    "timeout_s": 180
  },
  "llm": {
    "provider": "llamacpp",
    "base_url": "http://127.0.0.1:8080",
    "model": "auto",
    "temperature": 0.7,
    "max_tokens": 256
  },
  "tts": {
    "provider": "kokoro-onnx",
    "voice": "af_heart",
    "lang": "en-us",
    "speed": 1.0,
    "trim": true,
    "cache_dir": "model-cache/kokoro",
    "model_filename": "kokoro-v1.0.int8.onnx",
    "voices_filename": "voices-v1.0.bin",
    "model_url": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.int8.onnx",
    "voices_url": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin",
    "timeout_s": 300,
    "onnx_intra_op_num_threads": 4,
    "onnx_inter_op_num_threads": 1,
    "preload_g2p": true
  },
  "turn": {
    "barge_in": "cancel_tts",
    "tts_chunk_chars": 120,
    "min_tts_chars": 45
  }
}
